# .commit-profile  --  commit conventions for the git-commit skill.
#
# Inferred from this branch's history (rbdev) and confirmed 2026-08-19. Edit or
# delete to re-learn. Note that upstream ChampSim's own history is mixed
# ("chore: ...", "Fix/reversed caches (#687)", "Formatted with clang-format");
# the convention below is this fork's, which is consistent across 43 commits.

message:
  # `<component>: <imperative summary>`. The prefix is the SUBSYSTEM touched,
  # not a conventional-commit type -- history uses stats, blbp, ittage, btb,
  # cbp6, trace, heartbeat, cluster_configs, headroom alongside docs and test.
  # Hence `custom` rather than `conventional`.
  format: custom
  template: |
    <component>: <imperative summary>

    <Why the change was needed and what it does, wrapped at ~76 columns.
    Record real constraints, measured numbers, and rejected alternatives when
    they mattered -- this history is the research log for the branch, and a
    later reader needs to know why a parameter is what it is.>
  # 7 of 43 subjects exceed this today (longest 78); 72 is the target.
  subject_max: 72

trailers:
  # None required. History carries no Signed-off-by / DCO scheme.
  require: []

formatter:
  # No `make format` target exists; .clang-format (LLVM base, 160 col) is
  # enforced by the `lint` CI workflow, which reformats in place on push. Match
  # its file set exactly so a commit never loses a race with CI.
  cmd: "git diff --name-only --diff-filter=ACM HEAD -- src inc prefetcher branch replacement btb test tracer | grep -E '\\.(cc|h|hpp|inc)$' | xargs -r clang-format -i"

review:
  cmd: null

verify:
  # Builds and runs the Catch2 suite. ALSO run `make pytest` when anything
  # under config/ or test/python/ changed -- that covers the Python config
  # layer, which `make test` does not touch.
  #
  # Re-run ./config.sh after changing a JSON config or adding/renaming a
  # module, or the build will not reflect it.
  cmd: "make test"

staging:
  # Belt-and-suspenders over .gitignore. Everything config.sh generates lands
  # in .csconfig/, so there are no stray generated sources in the tree.
  exclude:
    - ".csconfig/"
    - "bin/"
    - "vcpkg_installed/"
    - "_configuration.mk"
    - "absolute.options"
    - "compile_commands.json"
    - "**/*.o"
    - "**/*.d"
    - "**/__pycache__/"
    - "*.log"
